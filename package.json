  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
